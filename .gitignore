# Default-deny local backend state: only Python source is versioned.
/backend/*
!/backend/*.py
/backend/__pycache__/
/frontend-deps/node_modules/
**/__pycache__/
*.py[cod]
*.sqlite*
*.db
*.gguf
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.log
*.part
*.tmp
.env
.env.*
*.pem
*.key
*.tar.gz
*.zip
.installed
.installing
.cache/
.venv/
node_modules/
